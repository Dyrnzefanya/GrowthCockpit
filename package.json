{
  "name": "du-anyam-performance-marketing-os",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.14.1"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:lead-coverage": "vitest run src/domain/leads/leads.test.ts src/domain/metrics/formulas.test.ts --coverage --coverage.include=src/domain/qualification/index.ts --coverage.include=src/domain/metrics/*.ts --coverage.include=src/domain/leads/rules.ts --coverage.include=src/domain/attribution/normalise.ts --coverage.thresholds.branches=100",
    "test:e2e": "playwright test",
    "test:production": "playwright test --config playwright.production.config.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "secrets:check": "node scripts/check-secrets.mjs",
    "secrets:client": "node scripts/check-client-secrets.mjs",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:migrate": "supabase db reset",
    "db:lint": "supabase db lint --local --level warning",
    "test:db": "node scripts/test-database.mjs",
    "db:types": "node scripts/generate-database-types.mjs"
  },
  "dependencies": {
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.116.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "csv-parse": "7.0.2",
    "lucide-react": "1.44.0",
    "next": "16.3.4",
    "radix-ui": "1.6.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "server-only": "0.0.1",
    "sonner": "2.0.8",
    "tailwind-merge": "3.6.0",
    "zod": "4.6.2"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "22.20.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitest/coverage-v8": "5.0.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.4",
    "jsdom": "29.1.1",
    "postcss": "8.5.28",
    "prettier": "3.9.6",
    "supabase": "2.117.0",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "vitest": "5.0.0"
  }
}
