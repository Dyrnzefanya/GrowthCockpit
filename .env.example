# Public (browser-visible; never secrets)
NEXT_PUBLIC_SUPABASE_URL=
# Supabase Settings > API Keys > Publishable key (current API key model)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Core server (Phase 0)
APP_ENV=                         # development | preview | production
SUPABASE_SECRET_KEY=             # Settings > API Keys > Secret key; server-only
APP_BASE_URL=                    # absolute URL used to build deep links
APP_TIMEZONE=                    # must be Asia/Jakarta

# Machine-to-machine auth (Phase 7; absent = honestly not configured)
# At least 32 random characters each; distinct server-only values.
INGEST_HMAC_SECRET=
INGEST_HMAC_SECRET_PREVIOUS=
CRON_SECRET=
JOBS_ENABLED=                    # true enables scheduled calls in production only

# HubSpot (Phase 8; server-only fallback; Settings-managed credentials win)
# Private app access token, app signing secret, and numeric portal ID. Never copied into Vault automatically.
HUBSPOT_ACCESS_TOKEN=
HUBSPOT_WEBHOOK_SECRET=
HUBSPOT_PORTAL_ID=

# Slack (Phase 9; server-only; absent = honestly not configured)
# Incoming Webhook for #pm-alerts in production and #pm-alerts-dev elsewhere.
SLACK_WEBHOOK_URL=

# Meta (Phase 10; server-only fallback; Settings-managed credentials win)
# Numeric account ID without act_. System User token with ads_read only. Never copied into Vault automatically.
META_AD_ACCOUNT_ID=
META_ACCESS_TOKEN=
META_API_VERSION=v26.0

# Deferred
# GA4_PROPERTY_ID=
# GOOGLE_ADS_CUSTOMER_ID=
